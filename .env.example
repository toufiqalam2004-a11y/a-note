# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel -> Project -> Settings -> Environment Variables.
# None of these are VITE_* variables, so none of them reach the browser bundle.

# Postgres connection string (Neon / Vercel Postgres / Supabase / any Postgres).
# The Vercel Neon integration sets POSTGRES_URL automatically; DATABASE_URL takes priority if both exist.
# Local: run `npm run db:local` and use the URL below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres

# Admin dashboard (/admin) password, 12+ characters.
ADMIN_PASSWORD=change-me-to-a-long-password

# Random secret (32+ chars) used to sign admin sessions and hash IPs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-64-random-hex-characters-from-the-command-above

# Local PGlite only accepts one connection at a time.
PG_POOL_MAX=1
